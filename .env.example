# Kopieer naar .env.local en vul in. Commit nooit .env.local.

# Publieke basis-URL van de site (voor canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shopify Storefront API. Zonder token draait de site op mock-data (lokaal).
# Openbaar Storefront-token uit het Headless-kanaal; wordt alleen server-side gebruikt.
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=
# Optioneel — standaard b1a9qw-p2.myshopify.com en 2026-10.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_API_VERSION=

# Testfase vóór de lancering (src/proxy.ts). Op Vercel is de standaard: overal de
# tijdelijke pagina. Alleen op SHOP_HOSTS draait de webshop, en alleen met wachtwoord.
SHOP_HOSTS=
# Inlog voor de testwebshop, als "gebruiker:wachtwoord". Alleen in Vercel zetten, nooit in Git.
TEST_BASIC_AUTH=
# Lancering: true = webshop op elk domein, proxy uit.
SITE_LIVE=
